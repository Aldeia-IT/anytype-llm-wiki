# Copy to .env and fill in values
# .env is gitignored — never commit secrets
ANYTYPE_API_KEY=
QDRANT_API_KEY=

# --- Local state directories (all optional; defaults shown) ---
# Host-local state, created 0700/0600. The work-log briefly holds narrated subject
# content in plaintext until it is drained into Anytype — treat it as sensitive
# (see docs/security-and-data-flow.md). For a same-host agent fleet writing one
# shared vault, all PIDs MUST share these two dirs; cross-host writers are not
# mutually excluded (see docs/known-limitations.md §10).
# WIKI_LOCK_DIR=~/.local/share/anytype-llm-wiki/locks
# WIKI_WORKLOG_DIR=~/.local/share/anytype-llm-wiki/worklog

# --- v0.3.0 wiki_ingest extraction (all optional; shown with defaults) ---
# Local-first by default. Setting WIKI_EXTRACT_ENDPOINT to a NON-local URL sends
# fetched source content off-machine and triggers a one-time consent banner.
# WIKI_EXTRACT_MODEL=qwen2.5:7b
# WIKI_EXTRACT_ENDPOINT=
# WIKI_EXTRACT_MAX_INPUT_TOKENS=8192
# Per-request read timeout (seconds) for the extraction model. Default 600 (10 min):
# large local models routinely take several minutes on a big source; too low a value
# trips the read timeout mid-generation and silently degrades extraction to
# heading-only candidates. Lower it for a fast model to fail quicker on a hung endpoint.
# WIKI_EXTRACT_TIMEOUT=600
# Whether the extraction model emits reasoning ("thinking") tokens. Default false
# so a thinking-capable model (e.g. qwen3.5-mlx) runs terse for extraction.
# WIKI_EXTRACT_THINK=false

# --- v0.3.0 fetch / SSRF ---
# WIKI_FETCH_MAX_BYTES=10485760
# WIKI_FETCH_EXTRA_PORTS=

# --- v0.3.0 entity-resolution thresholds (provisional defaults; tune per corpus) ---
# WIKI_UPSERT_THRESHOLD_TITLE=0.92
# WIKI_UPSERT_THRESHOLD_EMBEDDING=0.85
# WIKI_DUPLICATE_SURFACE_FLOOR=0.70

# --- v0.3.0 post-ingest reindex (set to false to disable auto-reindex) ---
# WIKI_AUTO_REINDEX=true

# --- v0.4.0 wiki_query tiered retrieval + synthesis (all optional; defaults shown) ---
# Object count at which retrieval flips from Tier 1 (index_navigation) to Tier 2
# (vector_augmented). Mode is vector_augmented when count >= threshold (inclusive).
# WIKI_INDEX_THRESHOLD=200
# File-back gate: a filed Query object is created (when file_back is left unset) only
# when the synthesized answer cites at least MIN_SOURCES distinct objects AND is at
# least MIN_WORDS words long. Pass file_back=True/False to override.
# WIKI_FILE_BACK_MIN_SOURCES=3
# WIKI_FILE_BACK_MIN_WORDS=100
# Synthesis input budget (token estimate = len(text) // 4). Total context, per-object
# head-truncation cap, and max object count fed to the synthesis model.
# WIKI_SYNTH_MAX_INPUT_TOKENS=8192
# WIKI_SYNTH_MAX_OBJECTS=24
# WIKI_SYNTH_MAX_OBJECT_TOKENS=1024
# Note: synthesis reuses WIKI_EXTRACT_TIMEOUT (default 600s) as a deliberate accepted
# ceiling; a slow-synthesis log signal fires when a single synthesis call exceeds 60s.
# All zero/negative values for the integer vars above fall back to their defaults.

# --- wiki_lint v0.5.0 structural health check (all optional; sensible defaults) ---
# You do NOT need to set any of these. Defaults shown.
# WIKI_LINT_OVERSIZED_CHARS=2000           # description length above which 'oversized' fires
# WIKI_LINT_ORPHAN_GRACE_DAYS=7            # age grace before an unlinked object is an orphan
# WIKI_LINT_STALE_NEEDS_REVIEW_DAYS=30     # needs-review age cutoff for 'stale_needs_review'
# WIKI_LINT_MAX_OBJECTS=2000               # duplicate sweep auto-skips above this object count
# WIKI_LINT_PIPELINE_WINDOW_SECONDS=300    # ±window for the pipeline_orphan timestamp heuristic
# WIKI_LINT_DUPLICATE_MAX_SCORE=0.85       # upper bound (exclusive) of the [0.70, 0.85) dup band
