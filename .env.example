# Copy to .env and fill in values
# .env is gitignored — never commit secrets
ANYTYPE_API_KEY=
QDRANT_API_KEY=

# --- v0.3.0 wiki_ingest extraction (all optional; shown with defaults) ---
# Local-first by default. Setting WIKI_EXTRACT_ENDPOINT to a NON-local URL sends
# fetched source content off-machine and triggers a one-time consent banner.
# WIKI_EXTRACT_MODEL=qwen2.5:7b
# WIKI_EXTRACT_ENDPOINT=
# WIKI_EXTRACT_MAX_INPUT_TOKENS=8192
# Per-request read timeout (seconds) for the extraction model. Default 600 (10 min):
# large local models routinely take several minutes on a big source; too low a value
# trips the read timeout mid-generation and silently degrades extraction to
# heading-only candidates. Lower it for a fast model to fail quicker on a hung endpoint.
# WIKI_EXTRACT_TIMEOUT=600

# --- v0.3.0 fetch / SSRF ---
# WIKI_FETCH_MAX_BYTES=10485760
# WIKI_FETCH_EXTRA_PORTS=

# --- v0.3.0 entity-resolution thresholds (provisional defaults; tune per corpus) ---
# WIKI_UPSERT_THRESHOLD_TITLE=0.92
# WIKI_UPSERT_THRESHOLD_EMBEDDING=0.85
# WIKI_DUPLICATE_SURFACE_FLOOR=0.70

# --- v0.3.0 post-ingest reindex (set to false to disable auto-reindex) ---
# WIKI_AUTO_REINDEX=true
