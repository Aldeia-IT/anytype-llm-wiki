__pycache__/
*.pyc
*.egg-info/
dist/
build/

# Environment-based secrets
.env
.env.local
.env.*.local

# Per-user Claude Code settings (never commit)
.claude/settings.local.json

# Watcher worktree lock files
.worktree.lock.d/

# SDLC agent signal files (abs-phase-complete, abs-pr-ready, abs-escalation).
# Written by pipeline leads to their work folder; consumed by the watcher.
abs-*

# UI-verification screenshots stay on disk in the work folder, never in git (aldeia-box #1109)
.aldeia/**/*.png
.aldeia/**/*.jpg
.aldeia/**/*.jpeg
.aldeia/**/*.webp
